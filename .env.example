# Local development reference; not loaded automatically by every package.
# See CONTRIBUTING.md for explicit process configuration and local ports.
# All defaults preserve mock clients and disable ledger-backed routes.
# Enabled demo runtimes require PostgreSQL; disabled mode needs no database.
SAMRA_BACKEND_MODE=disabled
# Opt-in onboarding-only boundary; migration 0018 starts admissions closed.
SAMRA_RELEASE_PROFILE=demo
SAMRA_PROVIDER_MODE=fake
SAMRA_PERSISTENCE_MODE=postgres
SAMRA_RUN_WORKER=false
SAMRA_CUSTOMER_AUTH_MODE=disabled
# Empty means no cross-origin access. Comma-separated canonical bare HTTPS origins.
SAMRA_ALLOWED_ORIGINS=
# Empty/false disables proxy trust. Only reviewed explicit IPs/CIDRs, never true/hops.
SAMRA_TRUSTED_PROXIES=
SAMRA_CUSTOMER_IDENTITY_PROVIDER_MODE=fake
SAMRA_CUSTOMER_WALLET_PROVIDER_MODE=fake

# Runtime PostgreSQL and destructive integration-test PostgreSQL must be
# separate databases. Never point TEST_DATABASE_URL at shared/runtime data.
DATABASE_URL=
TEST_DATABASE_URL=

# Client cutovers are deliberate. API mode never falls back to mock data.
VITE_SAMRA_DATA_MODE=mock
EXPO_PUBLIC_SAMRA_DATA_MODE=mock
EXPO_PUBLIC_SAMRA_API_ORIGIN=
EXPO_PUBLIC_SAMRA_AUTH_MODE=disabled

# Public/customer auth handoff is unconfigured. These values are public metadata,
# never credentials. Follow the activation runbook before connecting a tenant.
VITE_SAMRA_CUSTOMER_APP_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Private synthetic operations preview. The portal remains disabled unless
# both this browser flag and the server-side operations gate are explicit.
SAMRA_INTERNAL_OPERATIONS_ENABLED=false
VITE_SAMRA_OPERATIONS_ENABLED=false
VITE_SAMRA_OPS_DATA_MODE=mock
VITE_SAMRA_API_ORIGIN=
