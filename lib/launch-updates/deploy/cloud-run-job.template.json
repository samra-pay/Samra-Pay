{
  "apiVersion": "run.googleapis.com/v1",
  "kind": "Job",
  "metadata": {
    "name": "samra-production-resend-test",
    "namespace": "382465561715",
    "labels": {
      "cloud.googleapis.com/location": "us-east4"
    }
  },
  "spec": {
    "template": {
      "spec": {
        "parallelism": 1,
        "taskCount": 1,
        "template": {
          "spec": {
            "serviceAccountName": "samra-resend-test@samra-pay-production.iam.gserviceaccount.com",
            "maxRetries": 0,
            "timeoutSeconds": "60",
            "containers": [
              {
                "image": "REVIEWED_IMAGE_DIGEST_REQUIRED",
                "command": ["node", "./src/connection-test.mjs"],
                "args": [],
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "env": [
                  {
                    "name": "SAMRA_LAUNCH_UPDATES_MODE",
                    "value": "disabled"
                  },
                  {
                    "name": "SAMRA_CLOUD_PROJECT_ID",
                    "value": "samra-pay-production"
                  },
                  {
                    "name": "SAMRA_RESEND_SECRET_VERSION",
                    "value": "1"
                  },
                  {
                    "name": "SAMRA_LAUNCH_UPDATES_TEST_RECIPIENT",
                    "value": ""
                  },
                  {
                    "name": "SAMRA_LAUNCH_UPDATES_TEST_APPROVAL_ID",
                    "value": ""
                  },
                  {
                    "name": "SAMRA_LAUNCH_UPDATES_TEST_EXPIRES_AT",
                    "value": ""
                  },
                  {
                    "name": "RESEND_API_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "samra-production-resend-api-key",
                        "key": "1"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
