# Server-only example, not used or loaded automatically.
# The default makes no provider request and reads no key payload.
SAMRA_LAUNCH_UPDATES_MODE=disabled

# Populate ONLY for a separately approved, one-recipient connectivity test.
# The reply-to address is not permission to send a test to that inbox.
SAMRA_LAUNCH_UPDATES_TEST_RECIPIENT=
SAMRA_LAUNCH_UPDATES_TEST_APPROVAL_ID=
# UTC ISO timestamp with milliseconds, no more than one hour after test setup.
SAMRA_LAUNCH_UPDATES_TEST_EXPIRES_AT=

# Mount the approved NUMERIC version of samra-production-resend-api-key.
# Do not use latest; do not put this key into a VITE_/PUBLIC_ variable.
# David confirmed version 1 is Enabled; metadata/IAM are not independently verified.
SAMRA_RESEND_SECRET_VERSION=1
RESEND_API_KEY=

# The CLI additionally checks the actual job's injected CLOUD_RUN_* fields.
# Do not fake those fields to bypass the private-job execution boundary.
SAMRA_CLOUD_PROJECT_ID=samra-pay-production
