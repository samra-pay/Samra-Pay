{
  "name": "@workspace/samra-pay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:public-images": "node scripts/optimize-public-images.mjs",
    "dev": "pnpm run prepare:public-images && vite --config vite.config.ts --host 0.0.0.0",
    "dev:legacy": "pnpm run prepare:public-images && SAMRA_WEB_SURFACE=legacy vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run prepare:public-images && vitest run --config vitest.config.ts && vite build --config vite.config.ts && node scripts/check-public-build.mjs",
    "build:legacy": "pnpm run prepare:public-images && SAMRA_WEB_SURFACE=legacy vitest run --config vitest.config.ts && SAMRA_WEB_SURFACE=legacy vite build --config vite.config.ts",
    "optimize:public-images": "node scripts/optimize-public-images.mjs",
    "check:public-build": "node scripts/check-public-build.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "pnpm run prepare:public-images && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run prepare:public-images && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.24.1",
    "@tanstack/react-query": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/samra-client": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "@workspace/samra-pay-ds": "workspace:*",
    "framer-motion": "catalog:",
    "happy-dom": "^20.11.2",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^2.15.2",
    "sharp": "0.34.3",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.10",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  }
}
