{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Samra Pay — Midnight Gold design tokens (DTCG). Dark is the canonical source (the app renders dark-only); light is a warm-ivory derivation. Edit values here only — do not hand-edit src/index.css or src/generated/tokens.tsx. The build script (scripts/build-tokens.mjs) converts hex to `H S% L%` channels for the web theme and keeps hex for mobile.",
  "color": {
    "$type": "color",
    "light": {
      "$description": "Warm-ivory derived light mode. The Samra Pay app renders dark-only; this mode is provided for design-system consumers who need a light context.",
      "background":           { "$value": "#faf9f4", "$description": "Warm ivory page background." },
      "foreground":           { "$value": "#1a1505", "$description": "Very dark warm black body text." },
      "border":               { "$value": "#d4c99a" },
      "card":                 { "$value": "#ffffff" },
      "cardForeground":       { "$value": "#1a1505" },
      "popover":              { "$value": "#ffffff" },
      "popoverForeground":    { "$value": "#1a1505" },
      "primary":              { "$value": "#d4af37", "$description": "22-karat Midnight Gold — the Samra Pay brand color. Drives buttons, links, focus rings, and emphasis across both modes." },
      "primaryForeground":    { "$value": "#171717", "$description": "Near-black on gold — passes WCAG AA at ~8:1." },
      "secondary":            { "$value": "#f0ecdc", "$description": "Warm parchment surface." },
      "secondaryForeground":  { "$value": "#1a1505" },
      "muted":                { "$value": "#e8e2cc" },
      "mutedForeground":      { "$value": "#6b5d3a" },
      "accent":               { "$value": "#f5edcc", "$description": "Light gold wash — used for selected/active states in the app." },
      "accentForeground":     { "$value": "#7a6020" },
      "destructive":          { "$value": "#b83232" },
      "destructiveForeground":{ "$value": "#ffffff" },
      "input":                { "$value": "#cec49e" },
      "ring":                 { "$value": "#d4af37" },
      "chart1":               { "$value": "#d4af37", "$description": "Gold — primary data series." },
      "chart2":               { "$value": "#405943", "$description": "Muted green — ETB / transfer." },
      "chart3":               { "$value": "#80423a", "$description": "Muted red — debit / loss." },
      "chart4":               { "$value": "#b3943d", "$description": "Muted gold — secondary metric." },
      "chart5":               { "$value": "#666666", "$description": "Neutral gray — misc series." },
      "sidebar":              { "$value": "#faf9f4" },
      "sidebarForeground":    { "$value": "#1a1505" },
      "sidebarBorder":        { "$value": "#d4c99a" },
      "sidebarPrimary":       { "$value": "#d4af37" },
      "sidebarPrimaryForeground": { "$value": "#171717" },
      "sidebarAccent":        { "$value": "#f0ecdc" },
      "sidebarAccentForeground": { "$value": "#1a1505" },
      "sidebarRing":          { "$value": "#d4af37" }
    },
    "dark": {
      "$description": "Canonical dark mode — extracted directly from artifacts/samra-pay/src/index.css :root values.",
      "background":           { "$value": "#0a0a0a", "$description": "Near-black (hsl 0 0% 4%) page background." },
      "foreground":           { "$value": "#f5f5f5" },
      "border":               { "$value": "#1f1f1f" },
      "card":                 { "$value": "#0f0f0f", "$description": "hsl 0 0% 6% — slightly lighter than background." },
      "cardForeground":       { "$value": "#f5f5f5" },
      "popover":              { "$value": "#121212" },
      "popoverForeground":    { "$value": "#f5f5f5" },
      "primary":              { "$value": "#d4af37", "$description": "22-karat Midnight Gold (hsl 46 65% 52%). The single brand color across both modes." },
      "primaryForeground":    { "$value": "#171717" },
      "secondary":            { "$value": "#1a1a1a" },
      "secondaryForeground":  { "$value": "#f5f5f5" },
      "muted":                { "$value": "#1f1f1f" },
      "mutedForeground":      { "$value": "#adadad" },
      "accent":               { "$value": "#3f3610", "$description": "Dark gold wash (hsl 46 65% 15%) — selected state background." },
      "accentForeground":     { "$value": "#e9d99a", "$description": "Light gold text (hsl 46 65% 85%)." },
      "destructive":          { "$value": "#803636" },
      "destructiveForeground":{ "$value": "#fafafa" },
      "input":                { "$value": "#262626" },
      "ring":                 { "$value": "#d4af37" },
      "chart1":               { "$value": "#d4af37" },
      "chart2":               { "$value": "#405943" },
      "chart3":               { "$value": "#80423a" },
      "chart4":               { "$value": "#b3943d" },
      "chart5":               { "$value": "#666666" },
      "sidebar":              { "$value": "#0f0f0f" },
      "sidebarForeground":    { "$value": "#f5f5f5" },
      "sidebarBorder":        { "$value": "#1f1f1f" },
      "sidebarPrimary":       { "$value": "#d4af37" },
      "sidebarPrimaryForeground": { "$value": "#171717" },
      "sidebarAccent":        { "$value": "#1a1a1a" },
      "sidebarAccentForeground": { "$value": "#f5f5f5" },
      "sidebarRing":          { "$value": "#d4af37" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Outfit", "sans-serif"],      "$description": "Primary UI and body typeface. Used for all interface copy, labels, and body text. Weights 300–700 are in regular use; 300 (light) appears frequently in hero and display contexts." },
      "serif": { "$value": ["EB Garamond", "serif"],      "$description": "Display and editorial typeface. Used for hero headings, section titles, exchange-rate figures, and italic gold emphasis. Weights 400–700, with italic variants." },
      "mono":  { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.75rem", "$description": "Base corner radius (12 px). sm=8px, md=10px, lg=12px, xl=16px. Cards and panels use rounded-xl (16px); inputs and badges use rounded-md (10px)." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Base spacing step (4 px). Dashboard cards use p-6 (24px); page gutters use p-4/p-8; hero sections use pt-32 pb-24." }
  }
}
