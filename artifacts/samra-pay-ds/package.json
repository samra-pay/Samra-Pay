{
  "name": "@workspace/samra-pay-ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/generated/tokens.tsx",
    "./tokens": "./src/generated/tokens.tsx",
    "./styles.css": "./src/index.css",
    "./components/native": "./src/components/native/index.tsx",
    "./components/native/patterns": "./src/components/native/patterns/index.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.tsx",
    "./hooks/*": "./src/hooks/*.tsx"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.tsx",
    "#hooks/*": "./src/hooks/*.tsx"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-token-drift.mjs",
    "validate": "node scripts/build-tokens.mjs && node scripts/check-token-drift.mjs && pnpm run typecheck",
    "test": "node --test src/tests/tokens.test.mjs src/tests/contrast.test.mjs src/tests/a11y.test.mjs src/tests/docs.test.mjs",
    "test:a11y": "node --test src/tests/a11y.test.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "pretypecheck": "node scripts/build-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.79",
    "expo-font": ">=14",
    "@expo-google-fonts/outfit": ">=0.4",
    "@expo-google-fonts/eb-garamond": ">=0.4",
    "@expo-google-fonts/noto-serif-ethiopic": ">=0.4"
  },
  "peerDependenciesMeta": {
    "react-native": { "optional": true },
    "expo-font": { "optional": true },
    "@expo-google-fonts/outfit": { "optional": true },
    "@expo-google-fonts/eb-garamond": { "optional": true },
    "@expo-google-fonts/noto-serif-ethiopic": { "optional": true }
  },
