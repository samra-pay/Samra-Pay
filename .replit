modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "audit-expo-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run audit-expo-types"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/samra-pay-ops: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/samra-pay-ops"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/samra-pay-ops run dev"
cwd = "./artifacts/samra-pay-ops"
waitForPort = 21446
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "21446"
BASE_PATH = "/samra-pay-ops/"

[[workflows.workflow]]
name = "artifacts/samra-pay: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/samra-pay"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/samra-pay run dev"
cwd = "./artifacts/samra-pay"
waitForPort = 23471
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23471"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/samra-pay-commercial: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/samra-pay-commercial"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/samra-pay-commercial run dev"
cwd = "./artifacts/samra-pay-commercial"
waitForPort = 22141
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "22141"
BASE_PATH = "/samra-pay-commercial/"

[[workflows.workflow]]
name = "artifacts/samra-pay-mobile: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/samra-pay-mobile"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/samra-pay-mobile run dev"
cwd = "./artifacts/samra-pay-mobile"
waitForPort = 21314
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "21314"
BASE_PATH = "/mobile/"

[[workflows.workflow]]
name = "artifacts/samra-pay-ds: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/samra-pay-ds"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/samra-pay-ds run dev"
cwd = "./artifacts/samra-pay-ds"
waitForPort = 18682
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "18682"
BASE_PATH = "/samra-pay-ds/"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SAMRA_BACKEND_MODE = "demo"
SAMRA_PROVIDER_MODE = "fake"
SAMRA_PERSISTENCE_MODE = "postgres"
SAMRA_INTERNAL_OPERATIONS_ENABLED = "true"
SAMRA_RUN_WORKER = "true"
VITE_SAMRA_DATA_MODE = "api"
VITE_SAMRA_OPERATIONS_ENABLED = "true"
VITE_SAMRA_OPS_DATA_MODE = "api"
VITE_SAMRA_API_ORIGIN = "https://3400c1a5-15ed-481c-bb47-fda8d46ec7a9-00-1bt3es7szmlwn.worf.replit.dev"
