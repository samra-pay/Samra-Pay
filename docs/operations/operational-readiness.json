    {
      "id": "customer-data",
      "state": "blocked",
      "condition": "No customer data before retention, deletion, access, privacy, and incident controls are approved."
    },
    {
      "id": "live-provider",
      "state": "blocked",
      "condition": "No live provider, bank, wallet, or payout traffic before separately reviewed activation and recovery evidence."
    },
    {
      "id": "cloud-recovery",
      "state": "blocked",
      "condition": "No Cloud SQL recovery claim before backup freshness and an authorized restore-to-isolated-clone drill pass."
    },
    {
      "id": "service-level-claims",
      "state": "blocked",
      "condition": "No production RPO, RTO, availability, or response-time claim before targets and measurement are approved."
    },
    {
      "id": "incident-coverage",
      "state": "blocked",
      "condition": "No incident coverage claim before a named roster, staffed rotation, paging route, and drill exist."
    },
    {
      "id": "telemetry-activation",
      "state": "blocked",
      "condition": "No telemetry backend, collector endpoint, dashboard, alert route, or retention change without separate authorization."
    },
    {
      "id": "sensitive-evidence",
      "state": "blocked",
      "condition": "No credential, PII, financial payload, provider payload, or raw body in logs, traces, metrics, or evidence."
    },
    {
      "id": "automatic-economic-retry",
      "state": "blocked",
      "condition": "No automatic economic retry without the same durable idempotency key, bounded classification, and independent evidence."
    },
    {
      "id": "database-dump",
      "state": "blocked",
      "condition": "No database dump in retained CI, Qase, support, screenshot, release, or incident evidence."
