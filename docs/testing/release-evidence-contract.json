{
  "version": 1,
  "workflow": ".github/workflows/release-candidate.yml",
  "manifest": "artifacts/release-candidate/release-evidence-manifest.json",
  "manifestHash": "artifacts/release-candidate/release-evidence-manifest.sha256",
  "retentionDays": 365,
  "qaseEnvironment": "github-ci-postgres",
  "requiredGates": [
    {
      "id": "identity",
      "title": "Candidate SHA identity and main ancestry",
      "includeInQase": true
    },
    {
      "id": "security",
      "title": "Exact-SHA source, dependency, secret, configuration, SBOM, and license controls",
      "includeInQase": true
    },
    {
      "id": "quality",
      "title": "Linux workspace quality",
      "includeInQase": true
    },
    {
      "id": "commercial",
      "title": "Commercial package isolation",
      "includeInQase": true
    },
    {
      "id": "migrations",
      "title": "Current migration and repeatable seed",
      "includeInQase": true
    },
    {
      "id": "postgres_persistence",
      "title": "PostgreSQL persistence and ledger controls",
      "includeInQase": true
    },
    {
      "id": "postgres_http",
      "title": "HTTP, daily journey, and process restart",
      "includeInQase": true
    },
    {
      "id": "resilience",
      "title": "Weekly backend resilience controls",
      "includeInQase": true
    },
    {
      "id": "recovery",
      "title": "Synthetic logical PostgreSQL dump and restore rehearsal",
      "includeInQase": true
    },
    {
      "id": "performance",
      "title": "Million-posting materialized balance performance",
      "includeInQase": true
    },
    {
      "id": "qase_create",
      "title": "Qase release run creation",
      "includeInQase": false
    },
    {
      "id": "qase_upload",
      "title": "Qase release gate upload",
      "includeInQase": false
    },
    {
      "id": "qase_complete",
      "title": "Qase release run completion",
      "includeInQase": false
    }
  ],
  "requiredEvidenceFiles": [
    "artifacts/release-candidate/release-candidate-identity.json",
    "artifacts/release-candidate/release-gates.xml",
    "artifacts/release-candidate/qase-run.json",
    "artifacts/release-candidate/experience-budget-report.json",
    "artifacts/release-candidate/security/semgrep.json",
    "artifacts/release-candidate/security/trivy-vulnerabilities.json",
    "artifacts/release-candidate/security/trivy-secrets-misconfiguration.json",
    "artifacts/release-candidate/security/trivy-license-policy.json",
    "artifacts/release-candidate/security/sbom.cdx.json",
