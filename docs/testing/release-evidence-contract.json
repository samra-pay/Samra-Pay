  "boundaries": [
    "The candidate must be an exact 40-character commit contained in GitHub main.",
    "Use disposable PostgreSQL 16 and synthetic fixtures only.",
    "Do not access Replit, deployments, shared databases, real providers, production secrets, customer data, or live rails.",
    "A failed or missing gate remains failed after evidence upload; manual review cannot override it."
  ]
}
