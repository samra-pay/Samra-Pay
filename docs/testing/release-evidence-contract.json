    "artifacts/release-candidate/security/runtime-images/customer-web-secrets.json",
    "artifacts/release-candidate/security/runtime-images/operations-web-identity.json",
    "artifacts/release-candidate/security/runtime-images/operations-web-vulnerabilities.json",
    "artifacts/release-candidate/security/runtime-images/operations-web-secrets.json",
    "artifacts/release-candidate/security/runtime-images/design-system-identity.json",
    "artifacts/release-candidate/security/runtime-images/design-system-vulnerabilities.json",
