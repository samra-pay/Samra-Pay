{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run test && pnpm run typecheck && pnpm -r --filter \"!@workspace/samra-pay-commercial\" --if-present run build",
    "typecheck:libs": "tsc --build && pnpm -r --filter \"./lib/**\" --if-present run typecheck",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --filter \"!@workspace/samra-pay-commercial\" --if-present run typecheck",
    "test": "pnpm -r --filter \"!@workspace/samra-pay-commercial\" --if-present run test",
    "test:testing-cadence": "pnpm --filter @workspace/scripts run validate-testing-cadence",
    "test:release-contract": "pnpm --filter @workspace/scripts run validate-release-candidate",
    "test:action-pins": "pnpm --filter @workspace/scripts run validate-action-pins",
    "test:migration-policy": "pnpm --filter @workspace/scripts run validate-migration-policy",
    "test:repository-controls": "pnpm --filter @workspace/scripts run validate-repository-controls",
    "audit:repository-settings": "pnpm --filter @workspace/scripts run audit-repository-settings",
    "test:operational-readiness": "pnpm --filter @workspace/scripts run validate-operational-readiness",
    "test:experience-budgets": "pnpm --filter @workspace/scripts run validate-experience-budgets",
    "test:gcp-platform": "node --test deploy/gcp/*.test.mjs",
    "test:personas": "pnpm --filter @workspace/api-server run test:personas",
    "test:gcp-build-source": "node --test deploy/gcp/build-inputs.test.mjs deploy/gcp/container-contract.test.mjs",
    "commercial:typecheck": "pnpm --filter @workspace/samra-pay-commercial run typecheck",
    "commercial:build": "pnpm --filter @workspace/samra-pay-commercial run build",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "test:test-evidence": "node scripts/src/validate-test-evidence.mjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
