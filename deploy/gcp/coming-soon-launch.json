{
  "schemaVersion": 1,
  "status": "review-only",
  "launchPhase": "production-coming-soon",
  "deploymentAuthorized": false,
  "source": {
    "canonicalDesign": "Sites project appgprj_6a938306c6c08191a5d582603a18a2fe",
    "snapshotVersion": 13,
    "snapshotCommit": "4669b3482761373121b4ce06d0f1b20835181d2d",
    "refreshAtCutoverRequired": true,
    "releaseSource": "FULL_GIT_SHA"
  },
  "productionBoundary": {
    "projectId": "UNSET_PRODUCTION_PROJECT_ID",
    "projectNumber": "UNSET_PRODUCTION_PROJECT_NUMBER",
    "mustNotEqualProjectId": "samra-pay-staging",
    "billingAndBudgetApprovalRequired": true,
    "customerDataAllowedBeforeApproval": false
  },
  "images": {
    "registry": "REGION-docker.pkg.dev/PRODUCTION_PROJECT_ID/samra-production",
    "tag": "FULL_GIT_SHA",
    "digestRequired": true,
    "floatingTagsAllowed": false,
    "workloads": ["samra-customer-web", "samra-api", "samra-migrations"]
  },
  "edge": {
    "domain": "UNSET_CUSTOM_DOMAIN",
    "dnsOwner": "Squarespace",
    "loadBalancer": "global-external-application-load-balancer",
    "tls": "google-managed-certificate",
    "httpRedirectsToHttps": true,
    "cdnEnabled": true,
    "cloudArmorRequired": true,
    "waitlistRateLimit": {
      "requests": 10,
      "intervalSeconds": 60,
      "key": "client-ip",
      "action": "throttle"
    },
    "preserveDnsRecords": ["MX", "TXT", "SPF", "DKIM", "DMARC"]
  },
  "services": {
    "samra-customer-web": {
      "ingress": "internal-and-cloud-load-balancing",
      "publicAccess": "load-balancer-only",
      "defaultUrlDisabled": true,
      "serviceAccount": "dedicated-web",
      "databaseAccess": false,
      "secretAccess": [],
      "requiredEnvironment": {
        "SAMRA_API_PROXY_POLICY": "waitlist-only",
        "SAMRA_API_SERVICE_AUTH_MODE": "cloud-run-iam",
        "SAMRA_API_ORIGIN": "EXACT_PRIVATE_CLOUD_RUN_API_ORIGIN",
        "SAMRA_API_SERVICE_AUDIENCE": "EXACT_PRIVATE_CLOUD_RUN_API_ORIGIN"
      },
      "publicApiRoutes": ["POST /api/v1/waitlist/subscriptions"]
    },
    "samra-api": {
      "ingress": "internal-and-cloud-load-balancing",
      "authentication": "required",
      "defaultUrlDisabled": true,
      "serviceAccount": "dedicated-api",
      "invokers": ["dedicated-web"],
      "databaseAccess": true,
      "secretAccess": ["pinned-production-runtime-database-url"],
      "environment": {
        "NODE_ENV": "production",
        "SAMRA_BACKEND_MODE": "demo",
        "SAMRA_PROVIDER_MODE": "fake",
        "SAMRA_PERSISTENCE_MODE": "postgres",
        "SAMRA_RUN_WORKER": "false",
        "SAMRA_INTERNAL_OPERATIONS_ENABLED": "false",
        "SAMRA_CUSTOMER_AUTH_MODE": "disabled",
        "SAMRA_CUSTOMER_IDENTITY_PROVIDER_MODE": "fake"
      },
      "startupProbe": "/api/readyz",
      "livenessProbe": "/api/healthz"
    }
  },
  "data": {
    "store": "separate-private-production-postgresql",
    "stagingDatabaseReuseAllowed": false,
    "publicIpAllowed": false,
    "automaticMigrationAllowed": false,
    "migration": "lib/db/drizzle/0016_marketing_waitlist.sql",
    "secretVersion": "PINNED_INTEGER",
    "emailSeparatedFromAcquisitionTelemetry": true,
    "waitlistFields": [
      "normalized-email",
      "email-sha256",
      "consent-state",
      "consent-notice-version",
      "locale",
      "hashed-idempotency-key",
      "request-fingerprint",
      "server-timestamp"
    ],
    "authKycWalletDataAllowed": false
  },
  "observability": {
    "cloudLoggingRequired": true,
    "uptimeCheck": "GET /healthz through custom domain",
    "alerts": [
      "custom-domain certificate not active",
      "web 5xx rate",
      "API 5xx rate",
      "waitlist acceptance failure rate",
      "p95 request latency",
      "database connection saturation"
    ],
    "rawEmailInLogsAllowed": false
  },
  "release": {
    "candidateTraffic": 0,
    "promotionTraffic": 100,
    "priorRevisionRequired": true,
    "rollback": "restore recorded prior immutable Cloud Run revision without rebuild",
    "postPromotionVerification": [
      "custom-domain TLS",
      "home page and legal routes",
      "English and Amharic toggle",
      "one synthetic waitlist submission",
      "waitlist-only public API boundary",
      "uptime and error alerts"
    ]
  },
  "dnsCutover": {
    "order": [
      "verify production project, load balancer IP, certificate authorization, and rollback revision",
      "lower only affected web-record TTL",
      "point www to the verified Google endpoint",
      "verify HTTPS and waitlist end to end",
      "point apex after www is healthy",
      "leave email and verification records unchanged"
    ],
    "changesAuthorized": false
  },
  "blockedOn": [
    "final Sites refresh and visual approval",
    "confirmed production project ID and number",
    "confirmed public domain and canonical www/apex choice",
    "production billing, budget, and cost authorization",
    "separate production PostgreSQL and pinned secret",
    "privacy notice and consent wording approval",
    "load balancer, Cloud Armor, alerting, and rollback review",
    "explicit deployment and DNS cutover authorization"
  ],
  "excluded": [
    "Auth0 activation",
    "Persona activation",
    "Crossmint activation",
    "financial transaction APIs at the public edge",
    "staging database reuse",
    "Replit or Sites as production runtime",
    "Squarespace registrar transfer"
  ]
}
