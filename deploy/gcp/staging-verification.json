{
  "schemaVersion": 1,
  "status": "evidence-plane-implemented-execution-not-authorized",
  "environment": "staging",
  "dataClassification": "synthetic-only",
  "sourceRepository": "haileleuld87/Samra-Pay",
  "deployableServices": [
    "samra-api",
    "samra-customer-web",
    "samra-design-system-preview"
  ],
  "inputEvidence": {
    "zeroTrafficDeploymentManifest": "artifacts/staging-release/staging-zero-traffic-deployment.json",
    "zeroTrafficDeploymentManifestHash": "artifacts/staging-release/staging-zero-traffic-deployment.sha256",
    "imageVerificationManifest": "artifacts/staging-release/staging-image-verification.json",
    "imageVerificationManifestHash": "artifacts/staging-release/staging-image-verification.sha256",
    "probeManifest": "artifacts/staging-release/staging-verification-probe.json",
    "probeManifestHash": "artifacts/staging-release/staging-verification-probe.sha256"
  },
  "outputEvidence": {
    "manifest": "artifacts/staging-release/staging-verification.json",
    "manifestHash": "artifacts/staging-release/staging-verification.sha256",
    "retentionDays": 365
  },
  "requiredChecks": [
    "readiness",
    "restart",
    "serviceAuthentication",
    "ledger",
    "reconciliation",
    "audit",
    "failureVisibility"
  ],
  "qase": {
    "project": "SAMP",
    "environment": "google-cloud-staging",
    "completedPassingRunRequired": true,
    "exactRunUrlRequired": true
  },
  "imageVerificationFoundation": {
    "status": "workflow-implemented-execution-not-authorized",
    "contract": "deploy/gcp/staging-image-verification.json",
    "validator": "deploy/gcp/validate-staging-image-verification.mjs",
    "recorder": "deploy/gcp/record-staging-image-verification.mjs",
    "imageRunnerImplemented": true,
    "workflowImplemented": true,
    "executionAuthorized": false,
    "promotionEligible": false,
    "excludedPromotionChecks": [
      "serviceAuthentication",
      "deployedRevisionNetworkPath"
    ]
  },
  "probeAuthority": {
    "workflowName": "Staging verification probe",
    "workflowPath": ".github/workflows/staging-verification-probe.yml",
    "contract": "deploy/gcp/staging-revision-probe.json",
    "validator": "deploy/gcp/validate-staging-revision-probe.mjs",
    "recorder": "deploy/gcp/record-staging-revision-probe.mjs",
    "controller": "deploy/gcp/run-staging-revision-probe.sh",
    "federationActivation": "deploy/gcp/activate-staging-revision-probe-federation.sh",
    "federationAudit": "deploy/gcp/audit-staging-revision-probe-federation.sh",
    "protectedEnvironment": "staging-verification",
    "allowedRef": "refs/heads/main",
    "allowedEvent": "workflow_dispatch",
    "exactCandidateRevisionRequired": true,
    "deployedRevisionChecks": [
      "serviceAuthentication",
      "deployedRevisionNetworkPath"
    ],
    "implemented": true,
    "authorized": false
  },
  "recorder": {
    "path": "deploy/gcp/record-staging-verification.mjs",
    "requiresHashedInputs": true,
    "requiresExactCandidateBinding": true,
    "recordsSecrets": false,
    "recordsCustomerData": false,
    "implemented": true
  },
  "automaticTriggers": false,
  "trafficMutationAuthorized": false,
  "temporaryRoutingMutationAuthorized": false,
  "publicAccessMutationAuthorized": false,
  "runtimeMutationAuthorized": false,
  "vendorActivationAuthorized": false,
  "productionAuthorized": false,
  "prohibited": [
    "manual pass status without hashed image and probe evidence",
    "verification of a different commit, service, or revision",
    "claiming every check traversed the deployed HTTP revision",
    "partial combined required-check evidence",
    "non-passing or incomplete Qase staging run",
    "traffic percentage mutation",
    "persistent revision tag or service URL",
    "public IAM mutation",
    "runtime configuration mutation",
    "vendor activation",
    "production resource",
    "real customer data",
    "secret value in evidence",
    "Replit change"
  ]
}
