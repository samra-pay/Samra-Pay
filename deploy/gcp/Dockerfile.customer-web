# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PORT=8080
ENV BASE_PATH=/
ARG VITE_SAMRA_DATA_MODE=api
ENV VITE_SAMRA_DATA_MODE=$VITE_SAMRA_DATA_MODE

WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/samra-pay run build

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --chown=node:node deploy/gcp/static-server.mjs ./static-server.mjs
COPY --from=build --chown=node:node /workspace/artifacts/samra-pay/dist/public ./public

USER node
CMD ["node", "./static-server.mjs"]
