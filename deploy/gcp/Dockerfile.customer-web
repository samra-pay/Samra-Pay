# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PORT=8080
ENV BASE_PATH=/
ARG SAMRA_WEB_SURFACE=public
ARG VITE_SAMRA_DATA_MODE=api
ENV VITE_SAMRA_DATA_MODE=$VITE_SAMRA_DATA_MODE

WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN case "$SAMRA_WEB_SURFACE" in \
      public) pnpm --filter @workspace/samra-pay run build ;; \
      legacy) pnpm --filter @workspace/samra-pay run build:legacy ;; \
      *) echo "SAMRA_WEB_SURFACE must be public or legacy" >&2; exit 64 ;; \
    esac

FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --chown=node:node deploy/gcp/static-server.mjs ./static-server.mjs
COPY --from=build --chown=node:node /workspace/artifacts/samra-pay/dist/public ./public

USER node
CMD ["node", "./static-server.mjs"]
