# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:26-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --prod --filter @workspace/db... \
  && rm -rf /pnpm/store /root/.cache/pnpm

ENV NODE_ENV=production
WORKDIR /workspace/lib/db
USER node
CMD ["node", "./node_modules/drizzle-kit/bin.cjs", "migrate", "--config", "./drizzle.config.ts"]
