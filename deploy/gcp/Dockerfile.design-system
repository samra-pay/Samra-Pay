# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PORT=8080
ENV BASE_PATH=/

WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN node artifacts/samra-pay-ds/scripts/check-source-boundary.mjs
RUN pnpm --filter @workspace/samra-pay-ds run test
RUN pnpm --filter @workspace/samra-pay-ds run build

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --chown=node:node deploy/gcp/static-server.mjs ./static-server.mjs
COPY --from=build --chown=node:node /workspace/artifacts/samra-pay-ds/dist ./public

USER node
CMD ["node", "./static-server.mjs"]
