# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:26-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PORT=8080
ENV BASE_PATH=/

WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN node artifacts/samra-pay-ds/scripts/check-source-boundary.mjs
RUN pnpm --filter @workspace/samra-pay-ds run test
RUN pnpm --filter @workspace/samra-pay-ds run build

FROM node:26-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --chown=node:node deploy/gcp/static-server.mjs ./static-server.mjs
COPY --from=build --chown=node:node /workspace/artifacts/samra-pay-ds/dist ./public

USER node
CMD ["node", "./static-server.mjs"]
