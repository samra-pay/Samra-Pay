{
  "schemaVersion": 1,
  "status": "review-only",
  "environment": "staging",
  "dataClassification": "synthetic-only",
  "deploymentAuthorized": false,
  "imageContract": {
    "registry": "REGION-docker.pkg.dev/PROJECT_ID/samra-staging",
    "tag": "FULL_GIT_SHA",
    "immutableTagsRequired": true,
    "digestRecordedAfterBuild": true
  },
  "identities": {
    "build": "samra-cloud-build-staging@PROJECT_ID.iam.gserviceaccount.com",
    "deployer": "samra-deployer-staging@PROJECT_ID.iam.gserviceaccount.com",
    "api": "samra-api-staging@PROJECT_ID.iam.gserviceaccount.com",
    "customerWeb": "samra-customer-web-staging@PROJECT_ID.iam.gserviceaccount.com",
    "operationsWeb": "samra-operations-web-staging@PROJECT_ID.iam.gserviceaccount.com",
    "designSystem": "samra-design-system-staging@PROJECT_ID.iam.gserviceaccount.com",
    "migrations": "samra-migrations-staging@PROJECT_ID.iam.gserviceaccount.com"
  },
  "identityCapabilities": {
    "api": ["cloud-sql-client", "database-secret-accessor"],
    "migrations": ["cloud-sql-client", "database-secret-accessor"],
    "customerWeb": ["cloud-run-invoker:samra-api"],
    "operationsWeb": [],
    "designSystem": []
  },
  "database": {
    "engine": "postgresql-16",
    "instanceConnectionName": "PROJECT_ID:REGION:samra-staging-postgres",
    "database": "samra_staging",
    "network": "samra-staging-vpc",
    "subnet": "samra-staging-us-east4",
    "privateServicesAccessRange": "google-managed-services-samra-staging-vpc",
    "edition": "enterprise",
    "tier": "db-g1-small",
    "availabilityType": "zonal-non-production",
    "diskSizeGb": 10,
    "storageAutoResizeLimitGb": 50,
    "privateIpRequired": true,
    "publicIpAllowed": false,
    "dataApiAccess": "disallowed",
    "backupsRequired": true,
    "retainedBackups": 7,
    "pointInTimeRecoveryRequired": true,
    "transactionLogRetentionDays": 7,
    "deletionProtectionRequired": true,
    "automaticMigrationAllowed": false,
    "seedPolicy": "manual-idempotent-synthetic-only",
    "accessContract": "deploy/gcp/staging-database-access.json",
    "runtimeSecretReference": "projects/PROJECT_ID/secrets/samra-staging-database-url/versions/latest",
    "migrationSecretReference": "projects/PROJECT_ID/secrets/samra-staging-migration-database-url/versions/latest"
  },
  "services": {
    "samra-api": {
      "image": "samra-api:FULL_GIT_SHA",
      "serviceAccount": "api",
      "ingress": "internal-and-cloud-load-balancing",
      "authentication": "required",
      "defaultUrlDisabled": true,
      "minInstances": 0,
      "maxInstances": 2,
      "concurrency": 10,
      "databaseAccess": true,
      "secretAccess": ["runtime-database-url"],
      "requiredRuntimeEnvironment": ["AUTH0_ISSUER_BASE_URL", "AUTH0_AUDIENCE"],
      "databasePool": {
        "maxConnections": 5,
        "idleTimeoutMilliseconds": 30000,
        "connectionTimeoutMilliseconds": 10000
      },
      "environment": {
        "NODE_ENV": "production",
        "SAMRA_BACKEND_MODE": "demo",
        "SAMRA_PROVIDER_MODE": "fake",
        "SAMRA_PERSISTENCE_MODE": "postgres",
        "SAMRA_RUN_WORKER": "true",
        "SAMRA_INTERNAL_OPERATIONS_ENABLED": "false",
        "SAMRA_CUSTOMER_AUTH_MODE": "auth0",
        "SAMRA_CUSTOMER_IDENTITY_PROVIDER_MODE": "fake"
      },
      "startupProbe": "/api/readyz",
      "livenessProbe": "/api/healthz"
    },
    "samra-customer-web": {
      "image": "samra-customer-web:FULL_GIT_SHA",
      "serviceAccount": "customerWeb",
      "ingress": "internal-and-cloud-load-balancing",
      "authentication": "required",
      "defaultUrlDisabled": true,
      "minInstances": 0,
      "maxInstances": 2,
      "concurrency": 20,
      "databaseAccess": false,
      "secretAccess": [],
      "requiredRuntimeEnvironment": [
        "SAMRA_API_ORIGIN",
        "SAMRA_API_SERVICE_AUTH_MODE",
        "SAMRA_API_SERVICE_AUDIENCE",
        "SAMRA_PUBLIC_DATA_MODE",
        "SAMRA_PUBLIC_AUTH0_DOMAIN",
        "SAMRA_PUBLIC_AUTH0_CLIENT_ID",
        "SAMRA_PUBLIC_AUTH0_AUDIENCE"
      ],
      "apiProxyAuthentication": {
        "mode": "cloud-run-iam",
        "tokenSource": "cloud-run-metadata-service-identity",
        "serviceAuthorizationHeader": "X-Serverless-Authorization",
        "customerAuthorizationHeader": "Authorization",
        "audienceEnvironment": "SAMRA_API_SERVICE_AUDIENCE",
        "inboundServiceAuthorizationStripped": true,
        "credentialsStored": false
      }
    },
    "samra-operations-web": {
      "image": "samra-operations-web:FULL_GIT_SHA",
      "serviceAccount": "operationsWeb",
      "ingress": "internal-and-cloud-load-balancing",
      "authentication": "required",
      "defaultUrlDisabled": true,
      "minInstances": 0,
      "maxInstances": 1,
      "concurrency": 10,
      "databaseAccess": false,
      "secretAccess": [],
      "requiredRuntimeEnvironment": ["SAMRA_API_ORIGIN"],
      "deploymentBlockedOn": [
        "workforce authentication and authorization",
        "staff access review and revocation process",
        "operations API production-security promotion"
      ]
    },
    "samra-design-system-preview": {
      "image": "samra-design-system-preview:FULL_GIT_SHA",
      "serviceAccount": "designSystem",
      "ingress": "internal-and-cloud-load-balancing",
      "authentication": "required",
      "defaultUrlDisabled": true,
      "minInstances": 0,
      "maxInstances": 1,
      "concurrency": 20,
      "databaseAccess": false,
      "secretAccess": []
    }
  },
  "migrationJob": {
    "name": "samra-migrations",
    "image": "samra-migrations:FULL_GIT_SHA",
    "serviceAccount": "migrations",
    "tasks": 1,
    "parallelism": 1,
    "maxRetries": 0,
    "timeoutSeconds": 600,
    "manualExecutionOnly": true,
    "databaseAccess": true,
    "secretAccess": ["migration-database-url"]
  },
  "vendorReadiness": {
    "auth0": {
      "status": "required-before-staging-deployment",
      "apiMode": "auth0",
      "apiRuntimeEnvironment": ["AUTH0_ISSUER_BASE_URL", "AUTH0_AUDIENCE"],
      "customerWebRuntimeEnvironment": [
        "SAMRA_PUBLIC_AUTH0_DOMAIN",
        "SAMRA_PUBLIC_AUTH0_CLIENT_ID",
        "SAMRA_PUBLIC_AUTH0_AUDIENCE"
      ],
      "customerWebSecrets": [],
      "mobileRuntimeEnvironment": [
        "EXPO_PUBLIC_SAMRA_AUTH_MODE",
        "EXPO_PUBLIC_AUTH0_DOMAIN",
        "EXPO_PUBLIC_AUTH0_CLIENT_ID",
        "EXPO_PUBLIC_AUTH0_AUDIENCE"
      ],
      "mobileSecrets": [],
      "mobileSdk": "react-native-auth0@5.7.0",
      "mobileApplicationId": "com.samrapay.mobile.staging",
      "mobileCustomScheme": "samrapayauth",
      "mobileTokenStorage": "ios-keychain-android-encrypted-storage",
      "mobileBoundaryImplemented": true,
      "mobileClientConnected": false,
      "expoGoPreviewPreserved": true,
      "tokenAlgorithm": "RS256",
      "tokenStorage": "memory-only",
      "refreshTokensEnabled": false,
      "clientSecretAllowed": false,
      "activationBlockedOn": [
        "approved native application, API audience, callback, and logout inventory",
        "reviewed custom native development-build and distribution workflow",
        "disposable signed-token integration, logout, and restart evidence",
        "approved MFA, account recovery, deletion, incident, and support policy",
        "independent zero-traffic post-activation audit"
      ]
    },
    "persona": {
      "status": "prepared-not-authorized",
      "mode": "persona-sandbox",
      "serviceAccount": "api",
      "nonSecretRuntimeEnvironment": [
        "PERSONA_INQUIRY_TEMPLATE_ID",
        "PERSONA_ENVIRONMENT_ID"
      ],
      "secretMappings": {
        "PERSONA_API_KEY": {
          "secret": "samra-staging-persona-api-key",
          "version": "PINNED_INTEGER",
          "required": true
        },
        "PERSONA_WEBHOOK_SECRET": {
          "secret": "samra-staging-persona-webhook-secret",
          "version": "PINNED_INTEGER",
          "required": true
        },
        "PERSONA_WEBHOOK_SECRET_PREVIOUS": {
          "secret": "samra-staging-persona-webhook-secret-previous",
          "version": "PINNED_INTEGER",
          "required": false,
          "rotationOnly": true
        }
      },
      "secretAccessAuthorized": false,
      "activationBlockedOn": [
        "approved Persona sandbox account and immutable inquiry template inventory",
        "approved PII field, purpose, retention, deletion, support, and appeal policy",
        "exact secret versions and per-secret runtime IAM",
        "zero-traffic synthetic webhook and restart evidence",
        "independent post-activation audit"
      ]
    },
    "crossmint": {
      "status": "sandbox-adapter-dormant-not-authorized",
      "mode": "fake",
      "serviceAccount": "api",
      "stagingApiOrigin": "https://staging.crossmint.com/api/2025-06-09",
      "serverCredential": {
        "environment": "CROSSMINT_SERVER_API_KEY",
        "secret": "samra-staging-crossmint-server-api-key",
        "version": "PINNED_INTEGER"
      },
      "serverCredentialAllowedInClient": false,
      "secretAccessAuthorized": false,
      "sandboxAdapterImplemented": true,
      "liveAdapterImplemented": false,
      "activationBlockedOn": [
        "approved Crossmint sandbox account, USDC asset, test network, custody, signer, and recovery model",
        "least-privilege server API key scopes and exact secret version",
        "sandbox adapter activation, idempotency, timeout, replay, webhook, and restart evidence",
        "approved customer disclosure and support workflow",
        "independent ledger and provider-balance reconciliation gate"
      ]
    }
  },
  "releaseOrder": [
    "verify immutable image digests and release evidence",
    "verify backup and point-in-time recovery state",
    "execute reviewed migration job once",
    "deploy API revision with zero traffic",
    "pass API readiness, restart, ledger, reconciliation, and audit gates",
    "promote API traffic",
    "deploy authenticated customer web and design preview with zero traffic",
    "prove customer-web service identity can invoke API while preserving Auth0 bearer authorization",
    "promote customer web traffic",
    "deploy operations portal only after its blockers are closed",
    "run Qase staging regression",
    "retain Replit only as a bounded rollback surface"
  ],
  "approvalGates": [
    "approved staging project, billing owner, and region",
    "immutable Artifact Registry repository",
    "least-privilege build, deploy, runtime, and migration identities",
    "private Cloud SQL with backups and point-in-time recovery",
    "Secret Manager database reference with no plaintext credential",
    "approved load balancer and identity-aware access policy",
    "exact customer-web roles/run.invoker grant on samra-api and zero-traffic dual-token proof",
    "approved Auth0 tenant, API audience, callback, logout, and allowed-origin inventory",
    "separate Persona and Crossmint activation reviews with pinned secret versions",
    "logging, alerts, rollback owner, and cost budget",
    "critical Qase regression with no unresolved severity-one or severity-two defect"
  ],
  "forbidden": [
    "plaintext secrets",
    "default service accounts",
    "floating image tags",
    "automatic migrations",
    "public unauthenticated services",
    "real KYC or wallet providers without a separate activation gate",
    "customer data",
    "production claims",
    "Replit runtime dependency"
  ]
}
